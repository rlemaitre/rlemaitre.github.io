---
// Tinylytics replaces the button's content with "<wave emoji> <count>" (the symbol is hard-coded in its embed script
// and has no option), and the design bans emoji. The script below swaps the symbol for the word "Kudos".
// The text in the button is what visitors see until then (or when the script is blocked).
interface Props {
  label: string
}

const { label } = Astro.props
---

<button type="button" class="tinylytics_kudos mono" aria-label={label}>Kudos</button>

<script>
  const SYMBOL = '\u{1F44B}'
  document.querySelectorAll<HTMLElement>('.tinylytics_kudos').forEach((button) => {
    new MutationObserver(() => {
      if (button.textContent?.includes(SYMBOL)) {
        button.textContent = button.textContent.replace(SYMBOL, 'Kudos').trim()
      }
    }).observe(button, { childList: true, characterData: true, subtree: true })
  })
</script>

<style>
  .tinylytics_kudos {
    min-width: 44px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .tinylytics_kudos:hover {
    background: var(--ink);
    color: var(--bg);
  }
</style>
