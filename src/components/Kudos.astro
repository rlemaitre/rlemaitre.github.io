---
// Tinylytics replaces the button's content with "<wave emoji> <count>" (the symbol is hard-coded in its embed script
// and has no option), and the design bans emoji. The script below swaps the symbol for the word "Kudos".
// The text in the button is what visitors see until then (or when the script is blocked). It is also the accessible
// name, so the count is announced once Tinylytics has loaded it.
---

<button type="button" class="tinylytics_kudos mono">Kudos</button>

<script>
  import { replaceKudosEmoji } from '../lib/kudos'

  document.querySelectorAll<HTMLElement>('.tinylytics_kudos').forEach((button) => {
    const swap = () => {
      const text = button.textContent ?? ''
      const next = replaceKudosEmoji(text, 'Kudos')
      if (next !== text) button.textContent = next
    }
    swap()
    new MutationObserver(swap).observe(button, { childList: true, characterData: true, subtree: true })
  })
</script>

<style>
  .tinylytics_kudos {
    min-width: 44px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .tinylytics_kudos:hover {
    background: var(--ink);
    color: var(--bg);
  }
</style>
