---
import { type Lang } from '../lib/i18n'
import { SITE } from '../lib/site'

interface Props {
  title: string
  description: string
  lang: Lang
  ogImage?: string
  ogType?: 'website' | 'article'
}

const { title, description, lang, ogImage = '/og-default.png', ogType = 'website' } = Astro.props
const site = Astro.site ?? new URL(SITE.url)
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`
const canonical = new URL(Astro.url.pathname, site).href
const image = new URL(ogImage, site).href
const feed = lang === 'fr' ? '/fr/index.xml' : '/index.xml'
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US'
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  ;(() => {
    let theme = null
    try {
      theme = localStorage.getItem('theme')
    } catch {
      theme = null
    }
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    document.documentElement.dataset.theme = theme
  })()
</script>
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${lang.toUpperCase()})`} href={feed} />
<link rel="webmention" href={SITE.webmention} />
<link rel="pingback" href={SITE.pingback} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />

<script is:inline defer src={`https://tinylytics.app/embed/${SITE.tinylyticsId}.js?kudos`}></script>
