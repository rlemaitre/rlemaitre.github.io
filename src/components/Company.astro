---
/** A role's company: name, what it does, its acquirer and team; the company and acquirer link to their websites. */
import { t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
  job: { company: string; url?: string; about?: string; acquiredBy?: string; acquiredByUrl?: string; team?: string }
}

const { lang, job } = Astro.props
---

{job.url ? <a href={job.url}>{job.company}</a> : job.company}
{job.about && `, ${job.about}`}
{
  job.acquiredBy && (
    <span class="acquired">
      , {t(lang, 'nowPartOf')}{' '}
      <span class="name">
        {job.acquiredByUrl ? <a href={job.acquiredByUrl}>{job.acquiredBy}</a> : job.acquiredBy}
      </span>
    </span>
  )
}
{job.team && <span class="team"> — {job.team}</span>}
