---
import { getCollection } from 'astro:content'
import IndexRow from '../../components/IndexRow.astro'
import Base from '../../layouts/Base.astro'
import { talkUrl, t } from '../../lib/i18n'
import { talkTotals, venueSummary } from '../../lib/talks'

const talks = (await getCollection('talks'))
  .map((talk) => ({ talk, summary: venueSummary(talk.data.venues) }))
  .sort((a, b) => b.summary.lastYear - a.summary.lastYear || a.talk.data.title.localeCompare(b.talk.data.title))
const totals = talkTotals(talks.map(({ talk }) => talk.data))
const title = t('en', 'talks')
const span = ({ firstYear, lastYear }: { firstYear: number; lastYear: number }) =>
  firstYear === lastYear ? String(firstYear) : `${firstYear}–${lastYear}`
---

<Base title={title} description={`${totals.venues} venues in ${totals.countries} countries.`} lang="en" section="talks" altLangUrl="/fr/">
  <header class="intro">
    <p class="mono muted">{totals.venues} venues / {totals.countries} countries</p>
    <h1 class="display">{title}<em>.</em></h1>
  </header>
  <ul class="rows">
    {
      talks.map(({ talk, summary }) => (
        <IndexRow
          href={talkUrl(talk.id)}
          title={talk.data.title}
          meta={`${span(summary)} / ${summary.places.join(', ')}`}
          tag={`×${summary.count}`}
        />
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    padding: 18px var(--gutter) 28px;
  }

  .display {
    margin-top: 8px;
    font-size: clamp(56px, 12vw, 128px);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-thick) solid var(--ink);
    border-bottom: var(--rule-thick) solid var(--ink);
  }
</style>
